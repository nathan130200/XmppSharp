<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/nathan130200/XmppSharp</RepositoryUrl>
		<PackageTags>xmpp; xmpp library; jabber; xml; xml parser</PackageTags>
		<Version>7.0.0-preview-1</Version>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Expat.Net" Version="2.8.2-preview-1" />
	</ItemGroup>

</Project>
